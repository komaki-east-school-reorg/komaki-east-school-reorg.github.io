{
  "description": "公式ページ（data/official_pages/ のスラッグ）とサイト内の反映箇所の対応表。fetch-news.yml が本文変更を検知して Issue を起票したとき、サイトのどこを更新すべきか判断するために使う。スラッグは前方一致（slug_prefix）で照合する。",
  "site_targets": {
    "now_bar": {
      "file": "index.html / data/i18n/*.json",
      "notes": "トップ冒頭「いまの状況」枠。現況を一文で示す now_text と、その基準月 now_asof。状況が動いたら必ず更新する（全言語）"
    },
    "calendar": {
      "file": "data/events.json",
      "notes": "schedule.html のカレンダーイベント（日付キー＋8言語ラベル）"
    },
    "upcoming_bar": {
      "file": "index.html / data/i18n/ja.json, en.json",
      "notes": "「今後のスケジュール」バー（.upcoming-item の data-expires と upcoming_dateN / upcoming_nameN キー）"
    },
    "key_events": {
      "file": "schedule.html / data/i18n/*.json",
      "notes": "主要イベント一覧（data-event-date、状態バッジは自動）"
    },
    "current_status": {
      "file": "index.html / data/i18n/*.json",
      "notes": "現在の状況（data-event-date、完了ラベルは自動）"
    },
    "about": {
      "file": "about.html / data/i18n/*.json",
      "notes": "計画概要（背景・対象校・新校名・通学区域）"
    },
    "schedule_timeline": {
      "file": "schedule.html / data/i18n/*.json",
      "notes": "フェーズ別タイムライン"
    },
    "faq": {
      "file": "faq.html / data/i18n/*.json",
      "notes": "よくある質問"
    },
    "voices": {
      "file": "voices.html / data/i18n/*.json",
      "notes": "住民の声（賛成・反対・中立）"
    },
    "community": {
      "file": "community.html / data/i18n/*.json",
      "notes": "地域協議会・区長会への報告経緯"
    },
    "bus": {
      "file": "bus.html / data/i18n/*.json",
      "notes": "スクールバス情報"
    },
    "map": {
      "file": "map.html / data/i18n/*.json",
      "notes": "学校マップ・通学区域"
    },
    "kids": {
      "file": "data/i18n/ja-kids.json",
      "notes": "こどもむけモードの上書き辞書（小3レベル）"
    },
    "school_news": {
      "file": "data/school_news.json（自動生成・手編集不可）/ index.html の #school-news-container",
      "notes": "再編対象8校のホームページ更新コーナー。.github/scripts/fetch_schools.py が毎日更新するので手で編集しない"
    }
  },
  "default_targets": [
    "now_bar",
    "current_status",
    "faq"
  ],
